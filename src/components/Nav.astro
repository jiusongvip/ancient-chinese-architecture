---
const links = [
  { href: '/dynasties', label: 'Dynasties' },
  { href: '/elements', label: 'Elements' },
  { href: '/buildings', label: 'Buildings' },
  { href: '/urban-planning', label: 'Urban Planning' },
  { href: '/compare', label: 'Compare' },
  { href: '/gallery', label: 'Gallery' },
];
---

<nav class="fixed top-0 inset-x-0 z-50 bg-stone-light/80 backdrop-blur-md border-b border-stone-dark/30">
  <div class="max-w-[1400px] mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="w-8 h-8 rounded-sm bg-vermillion flex items-center justify-center">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 1L2 4v5c0 3.3 2.5 6.4 6 7 3.5-.6 6-3.7 6-7V4L8 1z" fill="white"/>
          <rect x="6" y="7" width="4" height="5" rx="0.5" fill="#b5343a"/>
          <rect x="5" y="5" width="6" height="3" rx="0.5" fill="#b5343a"/>
        </svg>
      </span>
      <span class="font-display font-semibold text-sm text-ink tracking-tight hidden sm:block">
        Ancient Chinese Architecture
      </span>
    </a>
    <div class="flex items-center gap-1">
      {links.map(link => (
        <a href={link.href} class="px-3 py-2 text-sm text-ink-muted hover:text-ink transition-colors rounded-md hover:bg-stone-dark/50 font-medium">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>
