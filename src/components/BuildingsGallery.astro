---
import { buildings } from '../data/buildings';
import { imageSizes } from '../data/imageSizes';

function imgProps(src: string) {
  const s = imageSizes[src];
  return { width: s?.width, height: s?.height };
}
---

<section class="py-24 px-6 bg-stone">
  <div class="max-w-[1400px] mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-14 reveal">
      <div>
        <h2 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-4">
          Visit These Buildings Today
        </h2>
        <p class="text-ink-muted text-lg max-w-[55ch]">
          All of these structures are open to visitors. Each card includes practical information to help you plan.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 reveal">
      {buildings.map((b, i) => (
        <a href={`/buildings/${b.id}`}
           class={`group flex flex-col rounded-2xl overflow-hidden border border-stone-dark/30 bg-stone-light hover:border-vermillion/25 hover:shadow-lg transition-all duration-300 ${i === 0 ? 'lg:col-span-2 lg:row-span-1' : ''}`}>
          <div class={`${i === 0 ? 'aspect-[21/9]' : 'aspect-[4/3]'} overflow-hidden relative`}>
            <img src={b.images[0]} alt={b.name} {...imgProps(b.images[0])} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute top-3 left-3 flex gap-2">
              <span class="px-2.5 py-1 rounded-full bg-vermillion/90 text-white text-xs font-medium">{b.dynasty}</span>
              <span class="px-2.5 py-1 rounded-full bg-jade/90 text-white text-xs font-medium flex items-center gap-1">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 2v4M12 14v8"/></svg>
                Open
              </span>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <h3 class="font-display font-bold text-lg text-ink mb-1 group-hover:text-vermillion transition-colors">{b.name}</h3>
            <p class="text-xs text-ink-muted mb-3">{b.chineseName} · {b.location} · {b.yearBuilt}</p>

            <div class="space-y-2 mt-auto pt-3 border-t border-stone-dark/30">
              <div class="flex items-start gap-2 text-xs text-ink-muted">
                <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0 text-gold" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Best: {b.travel.bestSeason.split(' or ')[0]}</span>
              </div>
              <div class="flex items-start gap-2 text-xs text-ink-muted">
                <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0 text-gold" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <span>{b.travel.photoTips.slice(0, 80)}...</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-12 reveal">
      <a href="/buildings" class="inline-flex items-center gap-2 px-5 py-2.5 bg-ink hover:bg-ink-light text-white font-medium rounded-lg transition-colors text-sm">
        View All Buildings with Travel Info
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
