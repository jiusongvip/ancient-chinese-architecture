---
---

<section class="py-20 px-6 bg-stone-light">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-4">What brings you here?</h2>
      <p class="text-ink-muted text-lg max-w-[60ch] mx-auto">Whether you are planning a trip, deep in research, or standing in front of a building right now — we have the right entry point for you.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal">
      <!-- Trip Planning -->
      <a href="/buildings" class="group block rounded-2xl border border-stone-dark/30 bg-stone hover:border-vermillion/25 hover:shadow-lg transition-all duration-300 p-7">
        <div class="w-12 h-12 rounded-xl bg-vermillion/10 flex items-center justify-center mb-5 group-hover:bg-vermillion/20 transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-vermillion"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"/></svg>
        </div>
        <p class="text-xs text-vermillion font-medium tracking-widest uppercase mb-2">Pre-Visit</p>
        <h3 class="font-display font-bold text-xl text-ink mb-2 group-hover:text-vermillion transition-colors">I am planning a trip</h3>
        <p class="text-sm text-ink-muted leading-relaxed mb-4">See which buildings you can visit today, the best season to go, how to get there, and where to get the perfect photograph.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-vermillion group-hover:gap-2.5 transition-all">
          Browse travel-ready buildings
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Research -->
      <a href="/dynasties" class="group block rounded-2xl border border-stone-dark/30 bg-stone hover:border-jade/25 hover:shadow-lg transition-all duration-300 p-7">
        <div class="w-12 h-12 rounded-xl bg-jade/10 flex items-center justify-center mb-5 group-hover:bg-jade/20 transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-jade"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <p class="text-xs text-jade font-medium tracking-widest uppercase mb-2">Deep Dive</p>
        <h3 class="font-display font-bold text-xl text-ink mb-2 group-hover:text-jade transition-colors">I am researching or studying</h3>
        <p class="text-sm text-ink-muted leading-relaxed mb-4">Explore architecture by dynasty, understand structural principles like dougong engineering, and compare styles across 3,000 years.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-jade group-hover:gap-2.5 transition-all">
          Explore by dynasty
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Identify -->
      <a href="#dynasty-identifier" class="group block rounded-2xl border border-stone-dark/30 bg-stone hover:border-gold/25 hover:shadow-lg transition-all duration-300 p-7">
        <div class="w-12 h-12 rounded-xl bg-gold/10 flex items-center justify-center mb-5 group-hover:bg-gold/20 transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
        </div>
        <p class="text-xs text-gold font-medium tracking-widest uppercase mb-2">On-Site</p>
        <h3 class="font-display font-bold text-xl text-ink mb-2 group-hover:text-gold transition-colors">I want to identify a building</h3>
        <p class="text-sm text-ink-muted leading-relaxed mb-4">You are standing in front of a Chinese building. What dynasty is it? Answer three quick visual questions and find out.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gold group-hover:gap-2.5 transition-all">
          Try the identifier
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>
