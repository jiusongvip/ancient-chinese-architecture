---
---

<section class="relative min-h-[100dvh] flex items-center pt-16 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero.webp"
      alt="Ancient Chinese architecture at dusk"
      width="1920" height="1441"
      class="w-full h-full object-cover"
      loading="eager" decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/88 via-ink/55 to-ink/15"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-light via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 w-full pt-8 pb-24">
    <div class="max-w-2xl">
      <p class="text-gold-light/90 text-sm font-medium tracking-widest uppercase mb-4 reveal font-display">
        Explore 3,000 Years of Heritage
      </p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold text-white leading-[1.05] mb-6 text-balance reveal">
        Ancient Chinese<br class="hidden sm:block" /> Architecture
      </h1>
      <p class="text-lg text-white/80 leading-relaxed max-w-[55ch] mb-8 reveal">
        From the sweeping roofs of the Forbidden City to the intricate dougong brackets of Tang temples. Discover where to go, what you are looking at, and how to understand it.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 mb-10 reveal" id="intent-bar">
        <a href="/dynasties" class="flex-1 group px-5 py-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15 hover:bg-white/20 hover:border-white/30 transition-all text-left">
          <span class="block text-white font-display font-semibold text-sm mb-0.5 group-hover:text-gold-light transition-colors">Explore by Dynasty</span>
          <span class="block text-white/50 text-xs">Shang to Qing timeline</span>
        </a>
        <a href="/buildings" class="flex-1 group px-5 py-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15 hover:bg-white/20 hover:border-white/30 transition-all text-left">
          <span class="block text-white font-display font-semibold text-sm mb-0.5 group-hover:text-gold-light transition-colors">Browse Famous Buildings</span>
          <span class="block text-white/50 text-xs">Forbidden City, Great Wall & more</span>
        </a>
        <a href="/compare" class="flex-1 group px-5 py-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15 hover:bg-white/20 hover:border-white/30 transition-all text-left">
          <span class="block text-white font-display font-semibold text-sm mb-0.5 group-hover:text-gold-light transition-colors">Compare Styles</span>
          <span class="block text-white/50 text-xs">Tang vs Song, Ming vs Qing</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Knowledge stats panel -->
  <div class="absolute bottom-0 inset-x-0 z-10">
    <div class="max-w-[1400px] mx-auto px-6 pb-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 reveal">
        <div class="rounded-xl bg-ink/70 backdrop-blur-md border border-white/35 p-4 text-center">
          <span class="block font-display font-bold text-3xl text-white mb-1 drop-shadow-md">3,000</span>
          <span class="block text-white/70 text-xs font-medium">Years of History</span>
        </div>
        <div class="rounded-xl bg-ink/70 backdrop-blur-md border border-white/35 p-4 text-center">
          <span class="block font-display font-bold text-3xl text-white mb-1 drop-shadow-md">9</span>
          <span class="block text-white/70 text-xs font-medium">Major Dynasties</span>
        </div>
        <div class="rounded-xl bg-ink/70 backdrop-blur-md border border-white/35 p-4 text-center">
          <span class="block font-display font-bold text-3xl text-white mb-1 drop-shadow-md">50+</span>
          <span class="block text-white/70 text-xs font-medium">UNESCO Sites</span>
        </div>
        <div class="rounded-xl bg-ink/70 backdrop-blur-md border border-white/35 p-4 text-center">
          <span class="block font-display font-bold text-3xl text-white mb-1 drop-shadow-md">4</span>
          <span class="block text-white/70 text-xs font-medium">Core Elements</span>
        </div>
      </div>
    </div>
  </div>
</section>
