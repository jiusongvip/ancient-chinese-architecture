---
const faqs = [
  { q: 'What is the oldest surviving wooden building in China?', a: 'The main hall of Foguang Temple (Nanchan Temple), built in 782 CE during the Tang dynasty, is China\'s oldest surviving timber-frame structure.' },
  { q: 'Why do traditional Chinese roofs curve upward?', a: 'The upward sweep serves both practical (water drainage, sunlight) and symbolic purposes (warding off evil spirits, expressing aspiration toward heaven).' },
  { q: 'What is a dougong, and why is it important?', a: 'Dougong is an interlocking wooden bracket system that distributes roof weight to columns. It allows for wide eaves without nails and absorbs seismic energy.' },
];
---

<section class="py-24 px-6 bg-stone">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-6">
          Latest Articles
        </h2>
        <div class="space-y-6">
          {[
            { title: 'The Mathematics of Dougong: How Ancient Builders Created Earthquake-Proof Structures', date: '2 weeks ago', href: '/blog/dougong-mathematics' },
            { title: 'Lost and Found: Recently Discovered Tang Dynasty Temple Ruins', date: '1 month ago', href: '/blog/tang-temple-ruins' },
            { title: 'Feng Shui and Architecture: The Science Behind the Alignment', date: '2 months ago', href: '/blog/feng-shui-architecture' },
          ].map(article => (
            <a href={article.href} class="block group p-5 rounded-xl border border-stone-dark/30 hover:border-vermillion/20 hover:bg-stone-light transition-all duration-200">
              <p class="text-xs text-ink-muted mb-1.5">{article.date}</p>
              <h3 class="font-display font-semibold text-ink group-hover:text-vermillion transition-colors leading-snug">{article.title}</h3>
            </a>
          ))}
        </div>
        <a href="/blog/" class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-vermillion hover:text-vermillion-dark transition-colors">
          All articles
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-6">
          Common Questions
        </h2>
        <div class="space-y-3">
          {faqs.map((faq, i) => (
            <details class="group rounded-xl border border-stone-dark/30 bg-stone-light p-5 cursor-pointer" open={i === 0}>
              <summary class="font-display font-semibold text-ink text-sm list-none flex items-center justify-between gap-4 marker:content-none">
                {faq.q}
                <svg class="w-4 h-4 flex-shrink-0 text-ink-muted group-open:rotate-180 transition-transform" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-muted leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
        <a href="/faq/" class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-vermillion hover:text-vermillion-dark transition-colors">
          All questions
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
