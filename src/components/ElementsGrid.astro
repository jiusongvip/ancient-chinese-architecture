---
import { elements } from '../data/elements';

const featured = elements.map(el => ({
  title: el.name,
  desc: el.description.slice(0, 130).trimEnd() + '…',
  href: `/elements/${el.id}`,
  image: el.image,
  width: 1200,
  height: 800,
}));
---

<section class="py-24 px-6 bg-stone-light">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-4">
        The Language of Chinese Architecture
      </h2>
      <p class="text-ink-muted text-lg max-w-[60ch] mx-auto">
        Six defining elements that set ancient Chinese buildings apart from any other architectural tradition.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
      {featured.map((el) => (
        <a href={el.href} class="group block rounded-2xl overflow-hidden border border-stone-dark/40 bg-stone hover:border-vermillion/25 hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={el.image} alt={el.title} width={el.width} height={el.height} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2 group-hover:text-vermillion transition-colors">{el.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{el.desc}</p>
            <span class="inline-flex items-center gap-1.5 mt-4 text-xs font-medium text-vermillion group-hover:gap-2.5 transition-all">
              Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
