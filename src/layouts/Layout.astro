---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}

const { title, description } = Astro.props;
const ogImage = Astro.props.ogImage ?? '/images/hero.webp';
const ogType = Astro.props.ogType ?? 'website';
const canonicalUrl = Astro.url.pathname === '/'
  ? new URL('/', Astro.site).href.replace(/\/$/, '')
  : new URL(Astro.url.pathname, Astro.site).href;

function truncateDescription(desc: string, maxLen = 157): string {
  if (desc.length <= maxLen) return desc;
  const cut = desc.substring(0, maxLen);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.substring(0, lastSpace) : cut) + '…';
}

const metaDescription = truncateDescription(description);
---

<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B7BTFNQQ4W"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-B7BTFNQQ4W');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={metaDescription} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Ancient Chinese Architecture" />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1441" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
   <meta name="twitter:description" content={metaDescription} />
   <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

   <meta name="author" content="Ancient Chinese Architecture Editorial Team" />
   <meta name="date" content="2026-07-31" />

   <!-- JSON-LD Structured Data -->
   <script type="application/ld+json">
     {
       "@context": "https://schema.org",
       "@type": "Person",
       "name": "Ancient Chinese Architecture Editorial Team",
       "url": "https://www.ancient-chinese-architecture.com/about/",
       "jobTitle": "Architectural Historians and Researchers",
       "description": "A team of researchers dedicated to documenting and explaining 3,000 years of Chinese architectural heritage.",
       "knowsAbout": ["Chinese Architecture", "Architectural History", "East Asian Studies", "Cultural Heritage"]
     }
   </script>
   <script type="application/ld+json">
     {
       "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Ancient Chinese Architecture",
      "url": "https://www.ancient-chinese-architecture.com",
      "description": "A digital museum exploring 3,000 years of Chinese architectural heritage.",
      "logo": "https://www.ancient-chinese-architecture.com/og-default.jpg"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Ancient Chinese Architecture",
      "url": "https://www.ancient-chinese-architecture.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.ancient-chinese-architecture.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
</head>
<body class="bg-stone-light text-ink antialiased">
  <slot />
</body>
</html>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
