---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Contact | Ancient Chinese Architecture" description="Contact the Ancient Chinese Architecture editorial team — corrections, contributions, travel questions, and partnership inquiries.">
  <Nav />
  <section class="pt-24 pb-16 px-6 bg-stone-light">
    <div class="max-w-[900px] mx-auto">
      <p class="text-vermillion text-sm font-medium tracking-widest uppercase mb-4 font-display">Contact</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-ink tracking-tight mb-6">Get in Touch</h1>
      <p class="text-lg text-ink-muted max-w-[65ch] mb-10">Questions, corrections, or contributions welcome. We typically reply within a few business days.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
        <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
          <div class="w-10 h-10 rounded-xl bg-vermillion/10 flex items-center justify-center mb-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-vermillion"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h2 class="font-display font-semibold text-ink mb-1">Email</h2>
          <p class="text-sm text-ink-muted mb-2">For corrections, research questions, and general inquiries.</p>
          <a href="mailto:hello@ancient-chinese-architecture.com" class="text-sm font-medium text-vermillion hover:text-vermillion-dark transition-colors">hello@ancient-chinese-architecture.com</a>
        </div>

        <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
          <div class="w-10 h-10 rounded-xl bg-jade/10 flex items-center justify-center mb-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-jade"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
          </div>
          <h2 class="font-display font-semibold text-ink mb-1">Corrections</h2>
          <p class="text-sm text-ink-muted mb-2">Spotted an error in a date, measurement, or attribution? Tell us so we can fix it.</p>
          <a href="mailto:hello@ancient-chinese-architecture.com?subject=Correction" class="text-sm font-medium text-vermillion hover:text-vermillion-dark transition-colors">Report an error</a>
        </div>

        <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
          <div class="w-10 h-10 rounded-xl bg-gold/10 flex items-center justify-center mb-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h2 class="font-display font-semibold text-ink mb-1">Contributions</h2>
          <p class="text-sm text-ink-muted mb-2">A topic you would like covered, or research to share? We would love to hear from you.</p>
          <a href="mailto:hello@ancient-chinese-architecture.com?subject=Contribution" class="text-sm font-medium text-vermillion hover:text-vermillion-dark transition-colors">Propose a topic</a>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-dark/30 bg-stone-light p-8">
        <h2 class="font-display font-bold text-xl text-ink mb-4">Before You Write</h2>
        <ul class="space-y-3 text-sm text-ink-muted leading-relaxed">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-vermillion" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Travel questions are answered on each <a href="/buildings/" class="text-vermillion hover:text-vermillion-dark transition-colors">building page</a> — opening hours, best seasons, and how to get there.
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-vermillion" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Common questions are covered in the <a href="/faq/" class="text-vermillion hover:text-vermillion-dark transition-colors">FAQ</a>.
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-vermillion" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            For reuse of our content, please review our <a href="/terms/" class="text-vermillion hover:text-vermillion-dark transition-colors">terms of use</a> first.
          </li>
        </ul>
      </div>
    </div>
  </section>
  <Footer />
</Layout>