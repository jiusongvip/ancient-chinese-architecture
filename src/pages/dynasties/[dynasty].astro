---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { dynasties } from '../../data/dynasties';

export function getStaticPaths() {
  return dynasties.map(d => ({ params: { dynasty: d.id } }));
}

const { dynasty } = Astro.params;
const d = dynasties.find(d => d.id === dynasty);
if (!d) return Astro.redirect('/dynasties/');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ancient-chinese-architecture.com/" },
    { "@type": "ListItem", "position": 2, "name": "Dynasties", "item": "https://www.ancient-chinese-architecture.com/dynasties/" },
    { "@type": "ListItem", "position": 3, "name": `${d.name} Dynasty`, "item": `https://www.ancient-chinese-architecture.com/dynasties/${d.id}/` }
  ]
};
const faqSchema = d.faq && d.faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": d.faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  : null;
---

 <Layout title={`${d.name} Dynasty Architecture – History, Features & Famous Buildings`} description={d.summary}>
   <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
   {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
   <Nav />

   <section class="pt-24 pb-8 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto">
      <a href="/dynasties/" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-6">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Dynasties
      </a>
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <span class="px-3 py-1.5 rounded-full bg-vermillion/10 text-vermillion text-sm font-medium">{d.years}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-ink tracking-tight mb-4">{d.name} Dynasty Architecture</h1>
      {d.tagline && <p class="text-base text-vermillion font-medium mb-3 italic">{d.tagline}</p>}
      <p class="text-lg text-ink-muted max-w-[70ch]">{d.summary}</p>
    </div>
  </section>

  <section class="py-2 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto">
      <img src={d.image} alt={`${d.name} Dynasty architecture`} class="w-full aspect-[21/9] object-cover rounded-2xl" loading="lazy" />
    </div>
  </section>

  <section class="py-12 px-6 bg-stone">
   <div class="max-w-[1400px] mx-auto">
     <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-12">
       <div>
         <h2 class="font-display font-bold text-2xl text-ink mb-6">Overview</h2>
         <p class="text-ink-muted leading-relaxed text-lg">{d.description}</p>
       </div>
        <div class="space-y-8">
          {d.sections.map(s => (
            <div>
              <h2 class="font-display font-bold text-2xl text-ink mb-3">{s.heading}</h2>
              {s.body.split('\n\n').map(p => (
                <p class="text-ink-muted leading-relaxed mb-4 last:mb-0">{p}</p>
              ))}
              {s.callout && (
                <div class="mt-6 rounded-2xl border border-vermillion/20 bg-vermillion/5 p-6">
                  <div class="flex items-start gap-4">
                    {s.callout.image && (
                      <img src={s.callout.image} alt={s.callout.title} class="w-20 h-20 rounded-xl object-cover flex-shrink-0" loading="lazy" />
                    )}
                    <div class="flex-1 min-w-0">
                      <p class="text-sm mb-2"><span class="text-lg mr-1">{s.callout.icon}</span><span class="font-display font-semibold text-ink">{s.callout.title}</span></p>
                      <p class="text-sm text-ink-muted leading-relaxed">{s.callout.body}</p>
                      {s.callout.link && (
                        <a href={s.callout.link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm text-vermillion hover:text-vermillion-dark mt-3 transition-colors">
                          {s.callout.link.text}
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
     </div>
     <div class="lg:col-span-2">
       <div class="rounded-2xl border border-stone-dark/30 bg-stone-light p-6">
         <h3 class="font-display font-semibold text-ink mb-4">Key Features</h3>
         <ul class="space-y-3">
            {d.features.map(f => (
              <li class="flex items-start gap-3 text-sm text-ink-muted">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-vermillion" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {d.notableBuildings.length > 0 && (
    <section class="py-12 px-6 bg-stone-light">
      <div class="max-w-[1400px] mx-auto">
        <h2 class="font-display font-bold text-2xl text-ink mb-6">Notable Buildings</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {d.notableBuildings.map(b => (
            <a href={b.href} class="group block p-5 rounded-xl border border-stone-dark/30 bg-stone hover:border-vermillion/20 hover:shadow-md transition-all">
              <h3 class="font-display font-semibold text-ink group-hover:text-vermillion transition-colors">{b.name}</h3>
              <span class="text-xs text-ink-muted mt-1 block">{d.name} Dynasty</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-12 px-6 bg-stone">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="font-display font-bold text-2xl text-ink mb-6">Navigate Dynasties</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {dynasties.map(dd => (
          <a href={`/dynasties/${dd.id}/`} class={`block p-4 rounded-xl border transition-all text-center ${dd.id === dynasty ? 'border-vermillion/40 bg-vermillion/5' : 'border-stone-dark/30 bg-stone-light hover:border-vermillion/20'}`}>
            <span class="font-display font-semibold text-ink text-sm block">{dd.name}</span>
            <span class="text-xs text-ink-muted">{dd.years}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {d.faq && d.faq.length > 0 && (
    <section class="py-12 px-6 bg-stone-light">
      <div class="max-w-[1400px] mx-auto">
        <h2 class="font-display font-bold text-2xl text-ink mb-8">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          {d.faq.map(f => (
            <details class="group rounded-2xl border border-stone-dark/30 bg-stone p-6 open:border-vermillion/30 transition-colors">
              <summary class="font-display font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-4">
                {f.q}
                <svg class="w-4 h-4 text-vermillion flex-shrink-0 group-open:rotate-45 transition-transform" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              </summary>
              <p class="text-sm text-ink-muted leading-relaxed mt-4">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.museumVisit && (
    <section class="py-12 px-6 bg-stone">
      <div class="max-w-[1400px] mx-auto">
        <h2 class="font-display font-bold text-2xl text-ink mb-3">Plan a {d.name} Architecture Trip</h2>
        <p class="text-ink-muted mb-8 max-w-[70ch]">{d.museumVisit.intro}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          {d.museumVisit.spots.map((spot, i) => (
            <div class={`rounded-2xl border ${i === 0 ? 'border-vermillion/30 bg-stone-light' : 'border-stone-dark/30 bg-stone-light'} overflow-hidden`}>
              {spot.image && (
                <img src={spot.image} alt={spot.name} class="w-full aspect-[16/9] object-cover" loading="lazy" />
              )}
              <div class="p-6">
                <h3 class="font-display font-bold text-lg text-ink mb-2">
                  {spot.href ? (
                    <a href={spot.href} target="_blank" rel="noopener noreferrer" class="hover:text-vermillion transition-colors">{spot.name} <svg class="inline w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg></a>
                  ) : spot.name}
                </h3>
                <p class="text-sm text-ink-muted leading-relaxed">{spot.highlight}</p>
                {spot.tip && (
                  <p class="text-xs text-vermillion mt-3 flex items-start gap-1.5">
                    <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    {spot.tip}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
        {d.museumVisit.extend && (
          <div class="rounded-2xl border border-stone-dark/30 bg-stone-light p-6">
            <p class="text-sm text-ink-muted leading-relaxed"><span class="font-semibold text-ink">Explore further: </span>{d.museumVisit.extend}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <Footer />
</Layout>
