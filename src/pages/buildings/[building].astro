---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { buildings } from '../../data/buildings';

export function getStaticPaths() {
  return buildings.map(b => ({ params: { building: b.id } }));
}

const { building } = Astro.params;
const b = buildings.find(b => b.id === building);
if (!b) return Astro.redirect('/buildings/');
---

 <Layout title={`${b.name} | Ancient Chinese Architecture`} description={b.description}>
   <script type="application/ld+json">
     {
       "@context": "https://schema.org",
       "@type": "BreadcrumbList",
       "itemListElement": [
         { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ancient-chinese-architecture.com/" },
         { "@type": "ListItem", "position": 2, "name": "Buildings", "item": "https://ancient-chinese-architecture.com/buildings/" },
         { "@type": "ListItem", "position": 3, "name": b.name, "item": null }
       ]
     }
   </script>
   <Nav />

   <section class="pt-24 pb-8 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto">
      <a href="/buildings" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-6">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Buildings
      </a>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1.5 rounded-full bg-vermillion/10 text-vermillion text-sm font-medium">{b.dynasty} Dynasty</span>
        <span class="px-3 py-1.5 rounded-full bg-stone border border-stone-dark/30 text-ink-muted text-sm">{b.type}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-ink tracking-tight mb-2">{b.name}</h1>
      <p class="text-ink-muted text-sm font-medium mb-2">{b.chineseName} · {b.location} · {b.yearBuilt}</p>
      <p class="text-lg text-ink-muted max-w-[70ch] leading-relaxed mt-4">{b.description.slice(0, 300)}</p>
    </div>
  </section>

  <section class="py-12 px-6 bg-stone">
    <div class="max-w-[1400px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-12">
        <div class="space-y-8">
          {b.sections.map(s => (
            <div>
              <h2 class="font-display font-bold text-2xl text-ink mb-3">{s.heading}</h2>
              <p class="text-ink-muted leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
        <div>
          <div class="sticky top-24 space-y-6">
            <div class="rounded-2xl border border-stone-dark/30 bg-stone-light p-6">
              <h3 class="font-display font-semibold text-ink mb-4">Quick Facts</h3>
              <ul class="space-y-3">
                {b.features.map(f => (
                  <li class="flex items-start gap-3 text-sm text-ink-muted">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-vermillion" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            {b.nearby.length > 0 && (
              <div class="rounded-2xl border border-stone-dark/30 bg-stone-light p-6">
                <h3 class="font-display font-semibold text-ink mb-3">Nearby Buildings</h3>
                <div class="space-y-2">
                  {b.nearby.map(n => (
                    <a href={n.href} class="block text-sm text-ink-muted hover:text-vermillion transition-colors py-1.5 border-b border-stone-dark/30 last:border-0">{n.name}</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
