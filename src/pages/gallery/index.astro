---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { buildings } from '../../data/buildings';
import { elements } from '../../data/elements';

const galleryImages = [
  // Buildings (2 images each)
  ...buildings.flatMap(b => [
    { src: b.images[0], alt: b.name, caption: b.name, category: b.type },
    { src: b.images[1], alt: `${b.name} detail`, caption: `${b.name} · Detail`, category: b.type },
  ]),
  // Elements
  ...elements.map(el => ({
    src: el.image, alt: el.name, caption: el.name, category: 'Elements',
  })),
];
---

<Layout title="Ancient Chinese Architecture Photo Gallery" description="Curated collection of high-resolution photographs of ancient Chinese architecture, organized by dynasty, building type, and region across China.">
  <Nav />
  <section class="pt-24 pb-8 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto text-center">
      <p class="text-vermillion text-sm font-medium tracking-widest uppercase mb-4 font-display">Gallery</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-ink tracking-tight mb-4">Photo Gallery</h1>
      <p class="text-lg text-ink-muted max-w-[65ch] mx-auto">A curated collection of architectural photography spanning China's built heritage — from the sweeping roofs of the Forbidden City to the intricate dougong brackets of ancient temples.</p>
      <div class="mt-8 max-w-[65ch] mx-auto text-left space-y-4 text-ink-muted leading-relaxed">
        <p>The gallery brings together two photographs for every building in our collection — one establishing view and one detail shot — plus a featured image for each of the six architectural elements. The result is a visual index of the entire site: scan the thumbnails to find a structure that catches your eye, then jump to its full reference page for history, engineering analysis, and visiting information.</p>
        <p>Photographs are organized by the same categories used across the site. Palace complexes from Beijing; timber pagodas and temple halls from Shanxi; the great grotto complexes of Luoyang, Datong, and Dunhuang; bridges from Hebei and beyond; and the ornamental details — brackets, roof ridges, and painted ceilings — that define the Chinese decorative vocabulary.</p>
        <p>All images are compressed to WebP format and optimized for fast loading without sacrificing detail. You can right-click any image to open it at full size.</p>
      </div>
    </div>
  </section>
  <section class="py-12 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto">
      <div class="mb-10">
        <h2 class="font-display font-bold text-2xl text-ink mb-4">Collections by Theme</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Imperial Palaces</h3>
            <p class="text-sm text-ink-muted leading-relaxed">The Forbidden City and the Summer Palace represent the peak of imperial construction — symmetry, hierarchy, and color encoded in timber and stone.</p>
          </div>
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Sacred Structures</h3>
            <p class="text-sm text-ink-muted leading-relaxed">Buddhist temples and pagodas — the Foguang Temple, the Yingxian Pagoda, and the Temple of Heaven — where engineering met ritual function.</p>
          </div>
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Grotto Complexes</h3>
            <p class="text-sm text-ink-muted leading-relaxed">The cliff-carved sanctuaries of Longmen, Yungang, and Mogao, documenting over a millennium of Buddhist sculpture and mural painting.</p>
          </div>
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Bridges &amp; Infrastructure</h3>
            <p class="text-sm text-ink-muted leading-relaxed">The Zhaozhou Bridge and the Great Wall show a different side of Chinese building — the engineering of movement, defense, and endurance.</p>
          </div>
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Architectural Elements</h3>
            <p class="text-sm text-ink-muted leading-relaxed">Close-ups of dougong brackets, roof profiles, courtyard layouts, and decorative details — the building blocks that recur across all periods.</p>
          </div>
          <div class="rounded-2xl border border-stone-dark/30 bg-stone p-6">
            <h3 class="font-display font-semibold text-lg text-ink mb-2">Mausoleums &amp; Monuments</h3>
            <p class="text-sm text-ink-muted leading-relaxed">The Ming Tombs and the Wild Goose Pagoda illustrate how death, memory, and commemoration shaped the landscape as powerfully as life did.</p>
          </div>
        </div>
      </div>
      <h2 class="font-display font-bold text-2xl text-ink mb-8">Architectural Photography</h2>
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 space-y-5">
        {galleryImages.map((img, i) => (
          <div class="break-inside-avoid rounded-2xl overflow-hidden border border-stone-dark/30 bg-stone group hover:border-vermillion/25 hover:shadow-lg transition-all duration-300">
            <img src={img.src} alt={img.alt} class="w-full object-cover" loading={i < 6 ? 'eager' : 'lazy'} />
            <div class="p-4">
              <p class="text-xs text-vermillion font-medium tracking-widest uppercase mb-1">{img.category}</p>
              <p class="text-sm text-ink font-medium">{img.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>
