---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { elements } from '../../data/elements';
---

<Layout title="Architectural Elements: Dougong, Roofs & Courtyards" description="Understand the key elements of ancient Chinese architecture — dougong brackets, roof types, courtyard layouts, and decorative motifs in detail.">
  <Nav />

  <section class="pt-24 pb-16 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto text-center">
      <p class="text-vermillion text-sm font-medium tracking-widest uppercase mb-4 font-display">Elements</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-ink tracking-tight mb-4">The Language of Chinese Architecture</h1>
      <p class="text-lg text-ink-muted max-w-[65ch] mx-auto">Understanding the key elements that distinguish ancient Chinese buildings from every other architectural tradition.</p>
    </div>
  </section>

  <section class="py-16 px-6 bg-stone-light">
    <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      {elements.map(el => (
        <a href={`/elements/${el.id}`} class="group block rounded-2xl overflow-hidden border border-stone-dark/30 bg-stone hover:border-vermillion/25 hover:shadow-lg transition-all duration-300">
          <div class="aspect-[16/9] overflow-hidden bg-gradient-to-br from-vermillion/10 via-stone-dark/50 to-jade/10">
            <img src={el.image} alt={el.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-6">
            <p class="text-xs text-vermillion font-medium mb-2">{el.subtitle}</p>
            <h2 class="font-display font-bold text-xl text-ink mb-2 group-hover:text-vermillion transition-colors">{el.name}</h2>
            <p class="text-sm text-ink-muted leading-relaxed mb-4">{el.description.slice(0, 180)}...</p>
            <div class="flex flex-wrap gap-2">
              {el.features.slice(0, 2).map(f => (
                <span class="text-xs text-ink-muted/70 bg-stone-light px-2.5 py-1 rounded-md">{f}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
