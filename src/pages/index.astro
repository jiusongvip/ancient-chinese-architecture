---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IntentCards from '../components/IntentCards.astro';
import TimelineStrip from '../components/TimelineStrip.astro';
import ElementsGrid from '../components/ElementsGrid.astro';
import BuildingsGallery from '../components/BuildingsGallery.astro';
import SeasonalPick from '../components/SeasonalPick.astro';
import PhotoGuide from '../components/PhotoGuide.astro';
import ComparePreview from '../components/ComparePreview.astro';
import ItineraryCards from '../components/ItineraryCards.astro';
import ArchitectureMap from '../components/ArchitectureMap.astro';
import BlogFAQPreview from '../components/BlogFAQPreview.astro';
import Footer from '../components/Footer.astro';
import DynastyIdentifier from '../components/DynastyIdentifier.astro';
---

<Layout
  title="Ancient Chinese Architecture: History, Style & Buildings"
  description="Explore 3,000 years of ancient Chinese architecture. Interactive dynasty timeline, architectural element guides, and famous building profiles from Tang temples to Ming palaces."
>
  <Nav />
  <Hero />
  <IntentCards />
  <TimelineStrip />
  <DynastyIdentifier />
  <ElementsGrid />
  <BuildingsGallery />
  <SeasonalPick />
  <PhotoGuide />
  <ComparePreview />
  <ItineraryCards />
  <ArchitectureMap />
  <BlogFAQPreview />
  <Footer />
</Layout>
