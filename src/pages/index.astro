---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IntentCards from '../components/IntentCards.astro';
import TimelineStrip from '../components/TimelineStrip.astro';
import ElementsGrid from '../components/ElementsGrid.astro';
import BuildingsGallery from '../components/BuildingsGallery.astro';
import TopicLinks from '../components/TopicLinks.astro';
import SeasonalPick from '../components/SeasonalPick.astro';
import PhotoGuide from '../components/PhotoGuide.astro';
import ComparePreview from '../components/ComparePreview.astro';
import ItineraryCards from '../components/ItineraryCards.astro';
import ArchitectureMap from '../components/ArchitectureMap.astro';
import BlogFAQPreview from '../components/BlogFAQPreview.astro';
import Footer from '../components/Footer.astro';
import DynastyIdentifier from '../components/DynastyIdentifier.astro';
import Overview from '../components/Overview.astro';
---

<Layout
  title="Ancient Chinese Architecture: History, Style & Buildings"
  description="Explore 3,000 years of ancient Chinese architecture: dynasty timeline, elements, iconic buildings, and travel guides for the Forbidden City and Great Wall."
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Ancient Chinese Architecture: History, Style & Buildings",
      "description": "Explore 3,000 years of ancient Chinese architecture: dynasty timeline, elements, iconic buildings, and travel guides for the Forbidden City and Great Wall.",
      "image": "https://www.ancient-chinese-architecture.com/images/hero.webp",
      "author": {
        "@type": "Person",
        "name": "Ancient Chinese Architecture",
        "url": "https://www.ancient-chinese-architecture.com/about/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Ancient Chinese Architecture",
        "url": "https://www.ancient-chinese-architecture.com"
      },
      "datePublished": "2026-07-31",
      "dateModified": "2026-07-31",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.ancient-chinese-architecture.com"
      }
    }
  </script>
  <Nav />
  <Hero />
  <Overview />
  <IntentCards />
  <TimelineStrip />
  <DynastyIdentifier />
  <ElementsGrid />
  <BuildingsGallery />
  <TopicLinks />
  <SeasonalPick />
  <PhotoGuide />
  <ComparePreview />
  <ItineraryCards />
  <ArchitectureMap />
  <BlogFAQPreview />
  <Footer />
</Layout>
