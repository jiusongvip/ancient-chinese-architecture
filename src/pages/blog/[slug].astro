---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { articles } from '../../data/blog';

export function getStaticPaths() {
  return articles.map(a => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = articles.find(a => a.slug === slug);
if (!article) return Astro.redirect('/blog/');

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.desc,
  "author": {
    "@type": "Person",
    "name": "Ancient Chinese Architecture",
    "url": "https://www.ancient-chinese-architecture.com/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ancient Chinese Architecture",
    "url": "https://www.ancient-chinese-architecture.com"
  },
  "datePublished": article.date,
  "dateModified": article.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.ancient-chinese-architecture.com/blog/${article.slug}/`
  }
};
---

<Layout title={`${article.title} | Ancient Chinese Architecture`} description={article.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <Nav />

  <section class="pt-24 pb-10 px-6 bg-stone-light">
    <div class="max-w-[900px] mx-auto">
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors mb-6">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All Articles
      </a>
      <p class="text-vermillion text-sm font-medium tracking-widest uppercase mb-2 font-display">{article.date}</p>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-ink tracking-tight mb-4">{article.title}</h1>
      <p class="text-lg text-ink-muted leading-relaxed">{article.desc}</p>
    </div>
  </section>

  <section class="py-12 px-6 bg-stone">
    <div class="max-w-[900px] mx-auto">
      <div class="space-y-10">
        {article.sections.map(s => (
          <div>
            <h2 class="font-display font-bold text-2xl text-ink mb-3">{s.heading}</h2>
            {s.body.split('\n\n').map(p => (
              <p class="text-ink-muted leading-relaxed mb-4 last:mb-0" set:html={p}></p>
            ))}
          </div>
        ))}
      </div>

      {article.quote && (
        <figure class="mt-12 rounded-2xl border-l-4 border-vermillion/50 bg-stone-light p-6">
          <blockquote class="text-ink-muted text-sm leading-relaxed italic">{article.quote.text}</blockquote>
          <figcaption class="text-xs text-ink-muted/70 mt-3 font-medium">— <cite>{article.quote.attribution}{article.quote.url ? <a href={article.quote.url} target="_blank" rel="nofollow noopener" class="text-vermillion hover:text-vermillion-dark transition-colors"> · Source</a> : null}</cite></figcaption>
        </figure>
      )}

      {article.citations.length > 0 && (
        <div class="mt-12 pt-8 border-t border-stone-dark/30">
          <p class="text-xs text-ink-muted tracking-widest uppercase mb-4 font-medium">Sources & Further Reading</p>
          <ul class="space-y-2">
            {article.citations.map(c => (
              <li class="text-sm text-ink-muted">
                <a href={c.url} target="_blank" rel="nofollow noopener" class="text-vermillion hover:text-vermillion-dark transition-colors">{c.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {article.relatedLinks.length > 0 && (
        <div class="mt-8 pt-6 border-t border-stone-dark/30">
          <p class="text-xs text-ink-muted tracking-widest uppercase mb-4 font-medium">Related Pages</p>
          <div class="space-y-2">
            {article.relatedLinks.map(r => (
              <a href={r.href} class="block text-sm text-ink-muted hover:text-vermillion transition-colors py-1">{r.label}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>